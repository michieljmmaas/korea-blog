{
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Security fixes only: turn off regular version updates for every package. vulnerabilityAlerts below re-enables updates for vulnerable versions.",
      "matchPackageNames": ["*"],
      "enabled": false
    }
  ],
  "rangeStrategy": "in-range-only",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on the first day of the month"],
    "automerge": true,
    "platformAutomerge": false,
    "commitMessageSuffix": "[deploy]"
  },
  "osvVulnerabilityAlerts": true,
  "transitiveRemediation": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": "security updates",
    "commitMessageSuffix": "[deploy]",
    "automerge": true,
    "platformAutomerge": false
  }
}
